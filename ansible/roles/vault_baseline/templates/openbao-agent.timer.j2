# {{ ansible_managed }}
# HOMELAB-56. pkiCert renews at about 1/9 of the lifetime left (3.3 days of 30), so a check
# every {{ vault_baseline_agent_interval }} renews within that much of the threshold.
[Unit]
Description=Check the OpenBao listener certificate every {{ vault_baseline_agent_interval }}

[Timer]
OnBootSec=5min
OnUnitActiveSec={{ vault_baseline_agent_interval }}
RandomizedDelaySec={{ vault_baseline_agent_random_delay }}
AccuracySec=1s

[Install]
WantedBy=timers.target
