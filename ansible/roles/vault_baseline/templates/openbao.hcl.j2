# {{ ansible_managed }}
# HOMELAB-30/31. Bootstrap transport until Phase 0.7d: plain-HTTP listener, with secrets
# only ever sent to 127.0.0.1 over SSH. cluster_addr's scheme is ignored; Raft and request
# forwarding on {{ vault_baseline_cluster_port }} always use TLS.

ui            = true
api_addr      = "http://{{ ansible_host }}:{{ vault_baseline_api_port }}"
cluster_addr  = "https://{{ ansible_host }}:{{ vault_baseline_cluster_port }}"
# No disable_mlock: OpenBao 2.0 removed mlock (GH-363); 2.6 flags the key as unknown. Swap is
# off and the unit sets MemorySwapMax=0.

listener "tcp" {
  address         = "0.0.0.0:{{ vault_baseline_api_port }}"
  cluster_address = "0.0.0.0:{{ vault_baseline_cluster_port }}"
  tls_disable     = 1
}

storage "raft" {
  path    = "{{ vault_baseline_openbao_data_dir }}"
  node_id = "{{ inventory_hostname }}"
{% for peer in vault_baseline_cluster_peers %}

  retry_join {
    leader_api_addr = "http://{{ peer }}:{{ vault_baseline_api_port }}"
  }
{% endfor %}
}

telemetry {
  prometheus_retention_time = "30s"
  disable_hostname          = true
}

log_level = "info"
